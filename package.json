{
  "name": "lrc-toolkit",
  "displayName": "LRC Toolkit",
  "description": "A lightweight toolkit for editing LRC (synced lyrics) files: highlighting, live diagnostics, timestamp hovers, sorting, offset shifting and precision normalization.",
  "version": "0.2.0",
  "publisher": "awwdd",
  "private": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "keywords": [
    "lrc",
    "lyrics",
    "karaoke",
    "synced lyrics",
    "music"
  ],
  "categories": [
    "Programming Languages",
    "Formatters",
    "Other"
  ],
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:lrc"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tubibibo/lrc-toolkit.git"
  },
  "homepage": "https://github.com/tubibibo/lrc-toolkit#readme",
  "bugs": {
    "url": "https://github.com/tubibibo/lrc-toolkit/issues"
  },
  "contributes": {
    "languages": [
      {
        "id": "lrc",
        "aliases": [
          "LRC",
          "lrc"
        ],
        "extensions": [
          ".lrc"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/lrc-file-icon.svg",
          "dark": "./media/lrc-file-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "lrc",
        "scopeName": "source.lrc",
        "path": "./syntaxes/lrc.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "lrc",
        "path": "./snippets/lrc.json"
      }
    ],
    "configuration": {
      "title": "LRC Toolkit",
      "properties": {
        "lrcToolkit.gapThresholdSeconds": {
          "type": "number",
          "default": 8,
          "minimum": 0,
          "description": "Gaps longer than this many seconds between consecutive lyric lines are flagged as instrumental gaps (hovers and statistics)."
        },
        "lrcToolkit.format.spaceAfterTimestamp": {
          "type": "boolean",
          "default": false,
          "description": "When formatting, normalize to exactly one space between the timestamp and the lyric text."
        },
        "lrcToolkit.sort.keepSectionLabels": {
          "type": "boolean",
          "default": false,
          "description": "When sorting, keep unrecognized lines (standalone section labels like [Chorus], plain prose, malformed lines) instead of dropping them: each kept line travels with the first cue line that follows it and is re-sorted together with that cue."
        }
      }
    },
    "commands": [
      {
        "command": "lrcToolkit.sortByTimestamp",
        "title": "LRC: Sort Lines by Timestamp"
      },
      {
        "command": "lrcToolkit.shiftTimestamps",
        "title": "LRC: Shift All Timestamps…"
      },
      {
        "command": "lrcToolkit.applyOffsetTag",
        "title": "LRC: Apply [offset:] Tag into Timestamps"
      },
      {
        "command": "lrcToolkit.normalizePrecision",
        "title": "LRC: Normalize Timestamp Precision…"
      },
      {
        "command": "lrcToolkit.stripWordTimings",
        "title": "LRC: Strip Enhanced (Word-Level) Timings"
      },
      {
        "command": "lrcToolkit.expandMultiStampLines",
        "title": "LRC: Expand Multi-Timestamp Lines"
      },
      {
        "command": "lrcToolkit.showStats",
        "title": "LRC: Show Document Statistics"
      },
      {
        "command": "lrcToolkit.mergeBilingualLines",
        "title": "LRC: Merge Bilingual Lines (original|translation)"
      },
      {
        "command": "lrcToolkit.splitBilingualLines",
        "title": "LRC: Split Bilingual Lines at '|'"
      },
      {
        "command": "lrcToolkit.invertOffsetSign",
        "title": "LRC: Invert [offset:] Sign"
      },
      {
        "command": "lrcToolkit.importSrt",
        "title": "LRC: Import Subtitles (SRT/VTT)…"
      },
      {
        "command": "lrcToolkit.exportSrt",
        "title": "LRC: Export as SRT…"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "lrcToolkit.sortByTimestamp",
          "when": "resourceLangId == lrc",
          "group": "lrcToolkit@1"
        },
        {
          "command": "lrcToolkit.applyOffsetTag",
          "when": "resourceLangId == lrc",
          "group": "lrcToolkit@2"
        },
        {
          "command": "lrcToolkit.showStats",
          "when": "resourceLangId == lrc",
          "group": "lrcToolkit@3"
        }
      ],
      "commandPalette": [
        {
          "command": "lrcToolkit.sortByTimestamp",
          "when": "resourceLangId == lrc"
        },
        {
          "command": "lrcToolkit.shiftTimestamps",
          "when": "resourceLangId == lrc"
        },
        {
          "command": "lrcToolkit.applyOffsetTag",
          "when": "resourceLangId == lrc"
        },
        {
          "command": "lrcToolkit.normalizePrecision",
          "when": "resourceLangId == lrc"
        },
        {
          "command": "lrcToolkit.stripWordTimings",
          "when": "resourceLangId == lrc"
        },
        {
          "command": "lrcToolkit.expandMultiStampLines",
          "when": "resourceLangId == lrc"
        },
        {
          "command": "lrcToolkit.showStats",
          "when": "resourceLangId == lrc"
        },
        {
          "command": "lrcToolkit.mergeBilingualLines",
          "when": "resourceLangId == lrc"
        },
        {
          "command": "lrcToolkit.splitBilingualLines",
          "when": "resourceLangId == lrc"
        },
        {
          "command": "lrcToolkit.invertOffsetSign",
          "when": "resourceLangId == lrc"
        },
        {
          "command": "lrcToolkit.importSrt"
        },
        {
          "command": "lrcToolkit.exportSrt",
          "when": "resourceLangId == lrc"
        }
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint .",
    "check:layering": "node scripts/check-layering.mjs",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "smoke": "node scripts/smoke-adapter.mjs",
    "package": "vsce package --no-dependencies",
    "verify": "npm run typecheck && npm run lint && npm run check:layering && npm run format:check && npm run test && npm run compile && npm run smoke && npm run package"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.17.10",
    "@types/vscode": "1.85.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
